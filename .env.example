# Copy this file to .env and fill in the values
# cp .env.example .env

# PostgreSQL credentials (used by both Docker Compose files)
# IMPORTANT: Set strong, unique passwords – do not use these examples in production
POSTGRES_DB=simulador_db
POSTGRES_USER=simulador
POSTGRES_PASSWORD=

# Backend
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://simulador:@localhost:5432/simulador_db

# Frontend (Vite dev server proxy target)
VITE_API_URL=http://localhost:3001
